{"info":{"description":"All endpoints of the Student Management REST API. Run the app first (`mvn spring-boot:run`), then execute the requests in order. The create request saves the new student's id to the `student_id` variable for the requests below it.","name":"Student Management REST API","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},"item":[{"event":[{"listen":"test","script":{"exec":["pm.test(\"Status is 201\", function () {","    pm.response.to.have.status(201);","});","var json = pm.response.json();","if (json.id) { pm.collectionVariables.set(\"student_id\", json.id.toString()); }"],"type":"text/javascript"}}],"name":"Create Student","request":{"body":{"mode":"raw","raw":"{\n  \"name\": \"Aarav Sharma\",\n  \"email\": \"aarav@example.com\",\n  \"course\": \"B.Tech CSE\",\n  \"age\": 20\n}"},"description":"Add a new student. Returns 201 Created. 400 on validation errors, 409 if the email is already registered.","header":[{"key":"Content-Type","value":"application/json"}],"method":"POST","url":{"host":["{{base_url}}"],"path":["api","students"],"raw":"{{base_url}}/api/students"}}},{"event":[{"listen":"test","script":{"exec":["pm.test(\"Status is 200\", function () {","    pm.response.to.have.status(200);","});"],"type":"text/javascript"}}],"name":"Get All Students","request":{"description":"Retrieve all students. Returns 200 OK with a JSON array (empty array if none exist).","method":"GET","url":{"host":["{{base_url}}"],"path":["api","students"],"raw":"{{base_url}}/api/students"}}},{"event":[{"listen":"test","script":{"exec":["pm.test(\"Status is 200\", function () {","    pm.response.to.have.status(200);","});"],"type":"text/javascript"}}],"name":"Get Student by ID","request":{"description":"Retrieve one student by ID. Returns 200 OK, or 404 if the ID does not exist.","method":"GET","url":{"host":["{{base_url}}"],"path":["api","students","{{student_id}}"],"raw":"{{base_url}}/api/students/{{student_id}}"}}},{"event":[{"listen":"test","script":{"exec":["pm.test(\"Status is 200\", function () {","    pm.response.to.have.status(200);","});"],"type":"text/javascript"}}],"name":"Update Student","request":{"body":{"mode":"raw","raw":"{\n  \"name\": \"Aarav S.\",\n  \"email\": \"aarav@example.com\",\n  \"course\": \"B.Tech IT\",\n  \"age\": 21\n}"},"description":"Update a student's details. Returns 200 OK. 404 if the ID does not exist, 400 on validation errors, 409 if the new email belongs to another student.","header":[{"key":"Content-Type","value":"application/json"}],"method":"PUT","url":{"host":["{{base_url}}"],"path":["api","students","{{student_id}}"],"raw":"{{base_url}}/api/students/{{student_id}}"}}},{"event":[{"listen":"test","script":{"exec":["pm.test(\"Status is 200\", function () {","    pm.response.to.have.status(200);","});"],"type":"text/javascript"}}],"name":"Get Students by Course","request":{"description":"Retrieve students by course (case-insensitive). Returns 200 OK with a JSON array.","method":"GET","url":{"host":["{{base_url}}"],"path":["api","students","course","B.Tech IT"],"raw":"{{base_url}}/api/students/course/B.Tech%20IT"}}},{"event":[{"listen":"test","script":{"exec":["pm.test(\"Status is 204\", function () {","    pm.response.to.have.status(204);","});"],"type":"text/javascript"}}],"name":"Delete Student","request":{"description":"Delete a student. Returns 204 No Content. 404 if the ID does not exist.","method":"DELETE","url":{"host":["{{base_url}}"],"path":["api","students","{{student_id}}"],"raw":"{{base_url}}/api/students/{{student_id}}"}}},{"event":[{"listen":"test","script":{"exec":["pm.test(\"Status is 404\", function () {","    pm.response.to.have.status(404);","});"],"type":"text/javascript"}}],"name":"Get Deleted Student (404 check)","request":{"description":"Run after Delete Student: proves the error handling returns a 404 with a JSON error body.","method":"GET","url":{"host":["{{base_url}}"],"path":["api","students","{{student_id}}"],"raw":"{{base_url}}/api/students/{{student_id}}"}}}],"variable":[{"key":"base_url","type":"string","value":"http://localhost:8080"},{"key":"student_id","type":"string","value":"1"}]}